# Copy to .env (never commit the real file)
DISCORD_BOT_TOKEN=
# Optional: TOTP secret for owner verification; verification is disabled when unset
OTP_SECRET=
# Directory holding macros.json, cynthia.db, logs and datasets. Overrides drive_path in config.yaml
DRIVE_PATH=/path/to/cynthia_drive
# Capture card `vendor:product` from `lsusb` (Elgato 4K X is 0fd9:009b). The card is reset with usbreset at startup; leave empty to skip
ELGATO_USB_ID=0fd9:009b
# Optional: guild ID that receives commands immediately after each sync
SYNC_GUILD_ID=
# Optional: comma-separated hosts pinged by /status (default: discord.com,github.com,google.com)
STATUS_HOSTS=discord.com,github.com,google.com
