# Copy to .env (never commit the real file)
DISCORD_BOT_TOKEN=
# Optional: TOTP secret for owner verification; verification is disabled when unset
OTP_SECRET=
# Directory holding macros.json, cynthia.db, logs and datasets. Overrides drive_path in config.yaml
DRIVE_PATH=/path/to/cynthia_drive
# Capture card `vendor:product` from `lsusb` (Elgato 4K X is 0fd9:009b). The card is reset with usbreset at startup; leave empty to skip
ELGATO_USB_ID=0fd9:009b
# Optional: guild ID that receives commands immediately after each sync
SYNC_GUILD_ID=
# Optional: comma-separated hosts pinged by /status (default: discord.com,github.com,google.com)
STATUS_HOSTS=discord.com,github.com,google.com
# Optional: Netscape-format cookies.txt exported from a YouTube Premium browser session, used by /music for age-restricted or members-only videos and private playlists
YTDL_COOKIES_FILE=
# Optional: obs-websocket connection (OBS > Tools > WebSocket Server Settings). Host/port default to 127.0.0.1:4455
OBS_WS_HOST=
OBS_WS_PORT=
OBS_WS_PASSWORD=
# Optional: stream key OBS uses; TWITCH_STREAM_KEY takes precedence for /twitch (never commit the real key)
OBS_STREAM_KEY=
TWITCH_STREAM_KEY=
# Optional: your Twitch channel name, used by /twitch url and the chat overlay
TWITCH_CHANNEL=
